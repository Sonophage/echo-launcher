#!/bin/sh
fail=0

# A change to the module graph must change the docs that describe it (owner, 2026-10-04).
# The graph is the include(...) lines of settings.gradle.kts and the project(...) dependencies of
# each build.gradle.kts; other build edits (a version bump) pass. checkStructure in the gate and CI
# checks the module map itself; this stops the commit early.
graph=$(git diff --cached -U0 -- 'settings.gradle.kts' '*build.gradle.kts' | grep -E '^[+-][^+-].*(include|project)\(":' )
if [ -n "$graph" ]; then
    if ! git diff --cached --name-only | grep -qE '^(CLAUDE\.md|\.claude/skills/)'; then
        echo "pre-commit: the module graph changed, but CLAUDE.md and .claude/skills/ did not:"
        echo "$graph"
        echo "Update the module map or the skill that covers the change. If neither is affected, commit with --no-verify."
        fail=1
    fi
fi

# Kotlin lines this commit adds, as "file: line". Only added lines are checked: old ones are rewritten
# when the code beside them changes (ADR 0001), so a line that is edited is checked too.
added=$(git diff --cached -U0 --diff-filter=AM -- '*.kt' | awk '/^\+\+\+ b\//{f=substr($0,7);next} /^\+/{print f": "substr($0,2)}')
# A line that only moved (removed and added unchanged in the same file) is not new wording, so the
# avoided-term check skips it; changing it to a new spot is not a reason to rename it.
removed=$(git diff --cached -U0 --diff-filter=M -- '*.kt' | awk '/^--- a\//{f=substr($0,7);next} /^\+\+\+ /{next} /^-/{print f": "substr($0,2)}')
moved=$(mktemp)
printf '%s\n' "$removed" > "$moved"
reworded=$(printf '%s\n' "$added" | grep -v -x -F -f "$moved")

# CONTEXT.md's avoided terms. Only the ones a grep can judge: several words, or an acronym (XMB).
# A term with a "(when ...)" qualifier, or a single common word, is the reviewer's call.
terms=$(mktemp)
trap 'rm -f "$terms" "$moved"' EXIT
sed -n 's/^_Avoid_: //p' CONTEXT.md | tr ',' '\n' | grep -v '(' | sed 's/^ *//;s/ *$//' | grep -E ' |^[A-Z]{2,}$' > "$terms"
if [ -s "$terms" ] && [ -n "$added" ]; then
    hits=$(printf '%s\n' "$reworded" | grep -i -w -F -f "$terms")
    if [ -n "$hits" ]; then
        echo "pre-commit: these added lines use a term CONTEXT.md says to avoid:"
        echo "$hits"
        echo "Use the glossary's term (CONTEXT.md). If the term is right here, commit with --no-verify."
        fail=1
    fi
fi

# An owner's decision is written beside the code as (owner, YYYY-MM-DD) (CLAUDE.md, Conventions).
# Only comments are read: after //, or a line of a /* */ block.
notes=$(printf '%s\n' "$added" | grep -E '//|^[^:]*: *(/?\*)' \
    | grep -i -E '\(owner\b|\bowner:|\bowner[- ](decision|reported|asked|said|request|call)' \
    | grep -v -E 'owner, 20[0-9]{2}-[0-9]{2}-[0-9]{2}')
if [ -n "$notes" ]; then
    echo "pre-commit: an owner note without the (owner, YYYY-MM-DD) form:"
    echo "$notes"
    fail=1
fi

exit $fail
