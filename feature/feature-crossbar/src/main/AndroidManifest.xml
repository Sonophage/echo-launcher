<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Declared HERE, in the module whose status strip calls registerNetworkCallback, and not
        only in the app's manifest. Lint analyses a library against its own manifest, so the app's
        declaration was invisible from here and the call read as unpermitted. Manifest merging
        unions the two, so the app is unchanged. Same reason feature-appbar declares
        PACKAGE_USAGE_STATS beside its own usage-stats read.

        A normal permission, granted at install.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- ECHO on a second screen (the AYN Thor's bottom screen). Its own task, kept out of Recents,
             so it never joins the Home task MainActivity runs in.

             It is the second display's home (SECONDARY_HOME), so HOME puts the Companion Screen there and
             not Android's own launcher; MainActivity's restart in onResume stays as the fallback. Android
             uses it only while ECHO is the default home, and it refuses a singleTask or singleInstance
             activity as a secondary home and falls back to the system's one, so this is singleTop.
             Exported, because the system resolves and starts it. -->
        <activity
            android:name="com.echo.feature.crossbar.bottomscreen.BottomScreenActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.bottom"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
